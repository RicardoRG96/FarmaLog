@page "/carga-de-pedidos"
@using FarmaLog.Portal.Cargas
@rendermode InteractiveServer
@inject ICargaProcessor Processor

<h3>CargaDePedidos</h3>

<InputFile onchange="Seleccionar" accept=".xlsx"/>

@if (_archivo is not null)
{
    <p>@_archivo.Name - @_archivo.ContentType - @_archivo.Size bytes </p>
    <button @onclick="Procesar" disabled="@_inProgress">PROCESAR ARCHIVO</button>
}

@if (_result is not null)
{
    @if (_result.Errors.Count > 0)
    {
        <h4 style="color:#b00">Resumen de validación</h4>
        <ul>
            @foreach (var e in _result.Errors)
            {
                <li style="color:#b00">@e</li>
            }
        </ul>
        <p><b>No se procesó ningún pedido.</b> Corrija el archivo y vuelva a cargarlo.</p>
    }
    else
    {
        <p style="color:#060">Se procesaron @_result.PublishedPedidos pedido(s).</p>
    }
}

@if (_error is not null)
{
    <p style="color:red">@_error</p>
}

@code {
    private const long MaximoBytes = 5 * 1024 * 1024;

    private IBrowserFile? _archivo;
    private ResultadoDeCarga? _result;
    private string? _error;
    private bool _inProgress;

    private void Seleccionar(InputFileChangeEventArgs e)
    {
        _archivo = e.File;
        _result = null;
        _error = null;
    }

    private async Task Procesar()
    {
        if (_archivo is null) return;

        _inProgress = true;
        _error = null;
        try
        {
            await using Stream stream = _archivo.OpenReadStream(MaximoBytes);
            _result = await Processor.ProcesarAsync(
                new ArchivoDeCarga(_archivo.Name, stream), CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _inProgress = false;
        }
    }
}
