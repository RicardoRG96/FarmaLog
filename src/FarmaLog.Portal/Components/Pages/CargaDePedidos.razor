@page "/carga-de-pedidos"
@using FarmaLog.Portal.Cargas
@rendermode InteractiveServer
@inject ICargaProcessor Processor

<style>
    .validation-summary {
        border: 1px solid #b00;
        border-left: 4px solid #b00;
        background: #fff5f5;
        padding: .75rem 1rem;
        margin-top: 1.5rem;
    }

        .validation-summary h4 {
            color: #b00;
            margin: 0 0 .5rem;
            font-size: 1rem;
        }

        .validation-summary ul {
            margin: 0 0 .5rem;
            padding-left: 1.25rem;
        }

        .validation-summary li {
            color: #b00;
            margin-bottom: .25rem;
        }

        .validation-summary .closing {
            margin: 0;
            color: #333;
        }

    .success {
        color: #060;
        font-weight: 600;
        margin-top: 1.5rem;
    }

    .file-row {
        margin: .75rem 0;
    }

    .actions button {
        margin-right: .5rem;
    }
</style>

<h3>Carga de pedidos</h3>

<div class="actions">
    <InputFile @key="_inputKey" onchange="Seleccionar" accept=".xlsx" />
    <button @onclick="Limpiar" disabled="@_inProgress">LIMPIAR</button>
</div>

@if (_archivo is not null)
{
    <p class="file-row">@_archivo.Name — @_archivo.Size bytes</p>
    <button @onclick="Procesar" disabled="@_inProgress">
        @(_inProgress ? "PROCESANDO…" : "PROCESAR ARCHIVO")
    </button>
}

@if (_result is not null)
{
    @if (_result.Errors.Count > 0)
    {
        <div class="validation-summary">
            <h4>Resumen de validación</h4>
            <ul>
                @foreach (var e in _result.Errors)
                {
                    <li>@e</li>
                }
            </ul>
            <p class="closing">
                <b>No se procesó ningún pedido.</b> Corrija el archivo y vuelva a cargarlo.
            </p>
        </div>
    }
    else
    {
        <p class="success">Se procesaron @_result.PublishedPedidos pedido(s).</p>
    }
}

@if (_error is not null)
{
    <p style="color:red">@_error</p>
}

@code {
    private const long MaximoBytes = 5 * 1024 * 1024;

    private IBrowserFile? _archivo;
    private ResultadoDeCarga? _result;
    private string? _error;
    private bool _inProgress;
    private int _inputKey;

    private void Seleccionar(InputFileChangeEventArgs e)
    {
        _archivo = e.File;
        _result = null;
        _error = null;
    }

    private void Limpiar()
    {
        _archivo = null;
        _result = null;
        _error = null;
        _inputKey++;   // fuerza a Blazor a recrear el <input>, que conserva
                       // el nombre del archivo aunque se limpie el estado de C#
    }

    private async Task Procesar()
    {
        if (_archivo is null) return;

        _inProgress = true;
        _error = null;
        _result = null;   // el resultado anterior no debe sobrevivir a una corrida nueva
        try
        {
            await using Stream stream = _archivo.OpenReadStream(MaximoBytes);
            _result = await Processor.ProcesarAsync(
                new ArchivoDeCarga(_archivo.Name, stream), CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _inProgress = false;
        }
    }
}