@baseUrl = http://localhost:5365

### 1. Pedido válido → 200 con PV-0000000001
POST {{baseUrl}}/api/salesorders
Content-Type: application/json

{
  "CodigoLaboratorio": "23",
  "CuentaCliente": "23-0778903671",
  "DireccionDespacho": "23-778903671D1",
  "TipoOrdenVenta": "23F1",
  "EsCenabast": false,
  "DocumentoVentaCenabast": null,
  "Observacion": "Entregar en bodega 2",
  "FechaEntregaSolicitada": "2026-11-20",
  "NumeroDelivery": "DEL-0001",
  "OrdenCompra": null,
  "Urgencia": false,
  "Lineas": [ { "Sku": "SKU-1", "Cantidad": 100, "EstadoInventario": "DISPONIBLE", "Lote": null } ],
  "Almacen": "FLC1"
}

